# ---------------------------------------------------------------
# Plan9Basic — .gitignore
# RAD Studio / Delphi FireMonkey project
# ---------------------------------------------------------------

# ----- Compiler output (platform build folders) -----
Win32/
Win64/
Win64x/
WinARM64EC/
Linux64/
Android/
Android64/
OSX32/
OSX64/
OSXARM64/
iOSDevice32/
iOSDevice64/
iOSSimARM64/
iOSSimulator/

# ----- Delphi compiled-unit artefacts -----
*.dcu
*.dcp
*.dpu
*.hpp

# ----- C++ object / static-library files -----
*.o
*.a

# ----- Executables and native libraries -----
*.exe
*.dll
*.so
*.dylib
*.apk
*.ipa
*.aab

# ----- Auto-generated resource / symbol files -----
*.res
*.rsm
# ...except the project resource, which RAD Studio regenerates only when the
# project is opened in the IDE. Without it in the repository a fresh clone
# cannot be built from the command line at all.
!Plan9Basic.res
!Plan9BasicApplet.res

# ----- IDE and user-specific files -----
*.dsk
*.~dsk
*.dproj.local
*.identcache
*.tvsconfig
*.stat
__history/
__recovery/

# ----- Claude Code tool configuration (local only) -----
.claude/

# ----- Separate repository: github.com/AndreMurtaX/Plan9BasicAppletRunner -----
# Kept on disk as its own working copy; must not be nested inside this repo.
Plan9BasicAppletRunner/

# ----- Local backups / superseded snapshots (2.3 GB, not versioned here) -----
archive/

# ----- Website: distributable binaries and third-party ebooks -----
# Release builds published by the site (regenerated by the build, ~63 MB)
# Moved to dist/devenv/ on 2026-08-19: nothing links these since the site
# stopped handing out binaries. Kept as a guard -- Website/ is uploaded
# whole, so a build dropping 63 MB back in there must not be published.
Website/assets/devenv/*
# ...except this one. UnitMain.pas downloads it from
# plan9basic.com/assets/devenv/Translations.ini on first run, so it is a
# runtime dependency of every fresh install, not a build artefact. It was
# moved out of the publish tree on 2026-08-19 for being unreferenced -- no
# page links it -- and that would have 404ed the first run of every new
# installation. Tracked so a clone can publish a working site.
!Website/assets/devenv/Translations.ini
# Third-party PDFs served by the site (~66 MB, not project source)
Website/assets/ebooks/

# ----- Test runner build output -----
tests/bin/

# ----- Miscellaneous -----
*.bak
*.tmp
Thumbs.db
.DS_Store

# Python bytecode from the tools in tools/
__pycache__/
*.pyc

# Assembled by tools/package-site.py for upload. Never committed.
dist/

# Written by the IDE running with --selftest.
bin/

# RAD Studio writes this during the Deploy target
deployedassets.txt
