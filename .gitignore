# ---------------------------------------------------------------
# Plan9Basic — .gitignore
# RAD Studio / Delphi FireMonkey project
# ---------------------------------------------------------------

# ----- Compiler output (platform build folders) -----
Win32/
Win64/
Win64x/
WinARM64EC/
Linux64/
Android/
Android64/
OSX32/
OSX64/
OSXARM64/
iOSDevice32/
iOSDevice64/
iOSSimARM64/
iOSSimulator/

# ----- Delphi compiled-unit artefacts -----
*.dcu
*.dcp
*.dpu
*.hpp

# ----- C++ object / static-library files -----
*.o
*.a

# ----- Executables and native libraries -----
*.exe
*.dll
*.so
*.dylib
*.apk
*.ipa
*.aab

# ----- Auto-generated resource / symbol files -----
*.res
*.rsm

# ----- IDE and user-specific files -----
*.dsk
*.~dsk
*.dproj.local
*.identcache
*.tvsconfig
*.stat
__history/
__recovery/

# ----- Claude Code tool configuration (local only) -----
.claude/

# ----- Separate repository: github.com/AndreMurtaX/Plan9BasicAppletRunner -----
# Kept on disk as its own working copy; must not be nested inside this repo.
Plan9BasicAppletRunner/

# ----- Local backups / superseded snapshots (2.3 GB, not versioned here) -----
archive/

# ----- Website: distributable binaries and third-party ebooks -----
# Release builds published by the site (regenerated by the build, ~63 MB)
Website/assets/devenv/
# Third-party PDFs served by the site (~66 MB, not project source)
Website/assets/ebooks/

# ----- Test runner build output -----
tests/bin/

# ----- Miscellaneous -----
*.bak
*.tmp
Thumbs.db
.DS_Store
